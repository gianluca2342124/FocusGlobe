    "Focus feels better in the sky. Your phone becomes a focus balloon flight.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在天空中专注更舒服。你的手机会变成一次专注的热气球飞行。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आकाश में फ़ोकस बेहतर लगता है। आपका फ़ोन एक फ़ोकस बलून फ़्लाइट बन जाता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrarse sienta mejor en el cielo. Tu móvil se convierte en un vuelo en globo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La concentration est plus douce dans le ciel. Votre téléphone devient un vol en montgolfière."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus fühlt sich am Himmel besser an. Dein Handy wird zu einem Ballonflug."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В небе фокус даётся легче. Ваш телефон становится полётом на воздушном шаре."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Focar é melhor no céu. Seu celular vira um voo de balão de foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrarsi è più bello in cielo. Il tuo telefono diventa un volo in mongolfiera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrarea e mai plăcută pe cer. Telefonul tău devine un zbor cu balonul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focussen voelt beter in de lucht. Je telefoon wordt een focusballonvlucht."
          }
        }
      }
    },
