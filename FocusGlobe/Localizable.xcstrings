    "iOS doesn't let apps add widgets automatically — this is Apple's standard way to add any widget.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 不允许应用自动添加小组件 — 这是 Apple 添加任何小组件的标准方式。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ऐप्स को अपने-आप विजेट जोड़ने नहीं देता — कोई भी विजेट जोड़ने का यही Apple का मानक तरीका है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no permite que las apps añadan widgets automáticamente: esta es la forma estándar de Apple para añadir cualquier widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ne permet pas aux apps d'ajouter des widgets automatiquement — c'est la méthode standard d'Apple pour tout widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS erlaubt Apps nicht, Widgets automatisch hinzuzufügen – das ist Apples Standardweg für jedes Widget."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
