    "This flight’s progress and rewards will be lost, and you’ll leave the Sky you’re flying in." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt und Belohnungen dieses Flugs gehen verloren, und du verlässt den Himmel, in dem du fliegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
