    "This open-ended flight will end here. Its progress and rewards will be lost." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser offene Flug endet hier. Fortschritt und Belohnungen gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este vuelo sin límite acabará aquí. Se perderán su progreso y sus recompensas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce vol sans limite s’arrêtera ici. Sa progression et ses récompenses seront perdues."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह असीमित फ़्लाइट यहीं ख़त्म हो जाएगी। इसकी प्रगति और इनाम चले जाएँगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo volo senza limite finirà qui. I suoi progressi e le ricompense andranno persi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze open vlucht eindigt hier. De voortgang en beloningen gaan verloren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este voo sem limite vai terminar aqui. Seu progresso e recompensas serão perdidos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest zbor fără limită se va încheia aici. Progresul și recompensele se vor pierde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот бессрочный полёт закончится здесь. Его прогресс и награды будут потеряны."
