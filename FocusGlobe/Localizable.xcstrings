    "A quiet sky today — clear air ahead": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天天空很安静——前方晴空"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आकाश शांत है — आगे साफ़ हवा"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cielo tranquilo hoy: aire despejado por delante"
          }
