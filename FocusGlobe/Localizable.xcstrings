    "Every gold square is a day you truly focused. Keep the sky lit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个金色方块都是你真正专注的一天。让天空持续点亮。"
