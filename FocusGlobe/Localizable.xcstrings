    "Focus Shield uses Screen Time, which isn't available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注护盾使用“屏幕使用时间”，本设备不支持。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस शील्ड स्क्रीन टाइम का उपयोग करता है, जो इस डिवाइस पर उपलब्ध नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Escudo de Enfoque usa Tiempo de uso, que no está disponible en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bouclier de Concentration utilise Temps d'écran, indisponible sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fokus-Schild nutzt Bildschirmzeit, die auf diesem Gerät nicht verfügbar ist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щит Фокуса использует «Экранное время», недоступное на этом устройстве."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Escudo de Foco usa o Tempo de Uso, que não está disponível neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo Scudo Focus usa Tempo di utilizzo, non disponibile su questo dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scutul de Concentrare folosește Timp de utilizare, indisponibil pe acest dispozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Focusschild gebruikt Schermtijd, wat op dit apparaat niet beschikbaar is."
          }
        }
      }
    },
    "FocusGlobe never sees which apps you choose — your selection stays private on this device.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe 绝不会知道你选择了哪些应用 — 你的选择仅私密保存在本设备。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe कभी नहीं देखता कि आपने कौन-से ऐप चुने — आपका चयन इसी डिवाइस पर निजी रहता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe nunca ve qué apps eliges: tu selección permanece privada en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe ne voit jamais les applis que vous choisissez — votre sélection reste privée sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe sieht nie, welche Apps du wählst – deine Auswahl bleibt privat auf diesem Gerät."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe никогда не видит, какие приложения вы выбрали — выбор остаётся приватным на этом устройстве."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FocusGlobe nunca vê quais apps você escolhe — sua seleção fica privada neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe non vede mai quali app scegli: la tua selezione resta privata su questo dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe nu vede niciodată ce aplicații alegi — selecția ta rămâne privată pe acest dispozitiv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe ziet nooit welke apps je kiest — je selectie blijft privé op dit apparaat."
          }
        }
      }
    },
