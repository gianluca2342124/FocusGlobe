    "Main Window. Reserved to keep your Sky visible. Not available.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主舷窗。保留此处以保持天空可见。不可用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य खिड़की। आपका आकाश दिखता रहे, इसलिए आरक्षित। उपलब्ध नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventana principal. Reservada para mantener tu cielo a la vista. No disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre principale. Réservée pour garder votre ciel visible. Non disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauptfenster. Freigehalten, damit dein Himmel sichtbar bleibt. Nicht verfügbar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главное окно. Оставлено, чтобы небо оставалось видимым. Недоступно."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janela principal. Reservada para manter seu céu visível. Indisponível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestra principale. Riservata per tenere visibile il tuo cielo. Non disponibile."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fereastra principală. Rezervată ca cerul tău să rămână vizibil. Indisponibilă."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdvenster. Vrijgehouden zodat je lucht zichtbaar blijft. Niet beschikbaar."
          }
        }
      }
    },
