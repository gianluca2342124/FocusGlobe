    "iOS doesn't let apps add widgets automatically — this is Apple's standard way to add any widget." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS erlaubt Apps nicht, Widgets automatisch hinzuzufügen – das ist Apples Standardweg für jedes Widget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no permite que las apps añadan widgets automáticamente: esta es la forma estándar de Apple para añadir cualquier widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne permet pas aux apps d'ajouter des widgets automatiquement — c'est la méthode standard d'Apple pour tout widget."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ऐप्स को अपने-आप विजेट जोड़ने नहीं देता — कोई भी विजेट जोड़ने का यही Apple का मानक तरीका है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non consente alle app di aggiungere widget automaticamente: questo è il modo standard di Apple per qualsiasi widget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS laat apps niet automatisch widgets toevoegen — dit is Apples standaardmanier voor elk widget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não permite que apps adicionem widgets automaticamente — este é o jeito padrão da Apple para qualquer widget."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nu permite aplicațiilor să adauge widgeturi automat — acesta e modul standard Apple pentru orice widget."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не позволяет приложениям добавлять виджеты автоматически — это стандартный способ Apple для любого виджета."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 不允许应用自动添加小组件 — 这是 Apple 添加任何小组件的标准方式。"
          }
        }
      }
    },
