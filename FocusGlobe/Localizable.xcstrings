    "Private invitation link — only pilots with this link can join, and it expires on its own.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密邀请链接——只有持有此链接的飞行员可以加入，并且会自动过期。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी निमंत्रण लिंक — सिर्फ़ इस लिंक वाले पायलट शामिल हो सकते हैं, और यह अपने आप ख़त्म हो जाता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace de invitación privado: solo pueden unirse los pilotos que lo tengan, y caduca solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien d’invitation privé — seuls les pilotes disposant de ce lien peuvent rejoindre, et il expire de lui-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privater Einladungslink — nur Piloten mit diesem Link können beitreten, und er läuft von selbst ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватная ссылка-приглашение — присоединиться могут только пилоты с этой ссылкой, и она истекает сама."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Link de convite privado — só pilotos com este link podem entrar, e ele expira sozinho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Link di invito privato: solo i piloti che hanno questo link possono entrare, e scade da solo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Link de invitație privat — doar piloții cu acest link pot intra, iar el expiră singur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé-uitnodigingslink — alleen piloten met deze link kunnen meedoen, en hij verloopt vanzelf."
          }
        }
      }
    },
