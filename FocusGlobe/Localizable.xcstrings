    "Complete a flight early in the morning (before 8 am).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在清晨（早上 8 点前）完成一次飞行。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह जल्दी (सुबह 8 बजे से पहले) एक फ़्लाइट पूरी करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un vuelo a primera hora de la mañana (antes de las 8:00)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez un vol tôt le matin (avant 8 h)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe einen Flug früh am Morgen ab (vor 8 Uhr)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите полёт рано утром (до 08:00)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua um voo de manhã cedo (antes das 8h)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un volo di prima mattina (prima delle 8)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie un zbor dis-de-dimineață (înainte de ora 8)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi een vlucht vroeg in de ochtend (voor 8.00 uur)."
          }
        }
      }
    },
    "Complete a flight late at night (after 10 pm).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
