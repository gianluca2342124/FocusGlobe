      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许你遇到的飞行员向你发送机组请求。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन पायलटों से आप मिलते हैं उन्हें क्रू अनुरोध भेजने दें।"
