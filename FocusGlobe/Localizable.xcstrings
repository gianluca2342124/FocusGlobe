    "Deletes flights, coins, streaks, unlocks and your profile on this device. The app returns to first launch.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除本设备上的飞行、金币、连续记录、解锁内容与个人资料。应用将回到首次启动状态。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर फ़्लाइट, सिक्के, स्ट्रीक, अनलॉक और आपका प्रोफ़ाइल हटा देता है। ऐप पहली बार जैसा हो जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina vuelos, monedas, rachas, desbloqueos y tu perfil en este dispositivo. La app vuelve al primer inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime vols, pièces, séries, déblocages et votre profil sur cet appareil. L'app revient au premier lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Flüge, Münzen, Serien, Freischaltungen und dein Profil auf diesem Gerät. Die App startet wie beim ersten Mal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет полёты, монеты, серии, разблокировки и профиль на этом устройстве. Приложение вернётся к первому запуску."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui voos, moedas, sequências, desbloqueios e seu perfil neste dispositivo. O app volta ao primeiro início."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina voli, monete, serie, sblocchi e il tuo profilo su questo dispositivo. L'app torna al primo avvio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge zboruri, monede, serii, deblocări și profilul tău de pe acest dispozitiv. Aplicația revine la prima pornire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert vluchten, munten, reeksen, ontgrendelingen en je profiel op dit apparaat. De app keert terug naar de eerste start."
          }
        }
      }
    },
