    "Something didn't reach the sky. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些东西没能抵达天空。请再试一次。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ आकाश तक नहीं पहुँचा। कृपया फिर कोशिश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo no llegó al cielo. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose n’a pas atteint le ciel. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas hat den Himmel nicht erreicht. Versuch es noch einmal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то не долетело до неба. Попробуйте снова."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo não chegou ao céu. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa non è arrivato in cielo. Riprova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceva n-a ajuns pe cer. Încearcă din nou."
          }
        },
        "nl": {
