    "Only letters, numbers, spaces and _ are allowed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅允许字母、数字、空格和下划线。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अक्षर, अंक, स्पेस और _ की अनुमति है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se permiten letras, números, espacios y _."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les lettres, chiffres, espaces et _ sont autorisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt sind nur Buchstaben, Zahlen, Leerzeichen und _."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешены только буквы, цифры, пробелы и _."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são permitidos letras, números, espaços e _."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono ammessi solo lettere, numeri, spazi e _."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt permise doar litere, cifre, spații și _."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen letters, cijfers, spaties en _ zijn toegestaan."
          }
        }
      }
    },
