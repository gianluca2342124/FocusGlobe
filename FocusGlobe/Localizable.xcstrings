    "No spin yet — the video has to finish to earn your coins. If it didn't load, try again shortly." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Drehung — das Video muss zu Ende laufen, damit du deine Münzen bekommst. Falls es nicht geladen hat, versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay giro: el vídeo tiene que terminar para conseguir tus monedas. Si no se cargó, inténtalo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de tour — la vidéo doit se terminer pour gagner vos pièces. Si elle n’a pas chargé, réessayez bientôt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी स्पिन नहीं — सिक्के पाने के लिए वीडियो पूरा होना ज़रूरी है। अगर लोड नहीं हुआ, तो थोड़ी देर में फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun giro: il video deve finire per guadagnare le monete. Se non si è caricato, riprova tra poco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen draai — de video moet aflopen om je munten te verdienen. Als hij niet laadde, probeer het straks opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda sem giro — o vídeo precisa terminar para você ganhar suas moedas. Se não carregou, tente de novo em breve."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă nicio rotire — clipul trebuie să se termine ca să primești monedele. Dacă nu s-a încărcat, mai încearcă în scurt timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спина пока нет — чтобы получить монеты, видео должно доиграть. Если оно не загрузилось, попробуйте чуть позже."
          }
