    "Protect the calm from take-off through landing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从起飞到降落，守护这份宁静。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उड़ान भरने से उतरने तक शांति बनाए रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege la calma desde el despegue hasta el aterrizaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préservez le calme du décollage à l’atterrissage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze die Ruhe vom Start bis zur Landung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте спокойствие от взлёта до посадки."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja a calma da decolagem à aterrissagem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi la calma dal decollo all’atterraggio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Protejează liniștea de la decolare până la aterizare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherm de rust van opstijgen tot landen."
          }
        }
      }
    },
    "Protected flights ground your chosen apps for the whole journey, so the sky stays yours.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护的飞行会在整个旅程中停用你选择的应用，让天空只属于你。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित फ़्लाइट पूरी यात्रा के दौरान आपके चुने ऐप्स को रोक देती है, ताकि आकाश आपका ही रहे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vuelos protegidos dejan en tierra las apps que elijas durante todo el trayecto, para que el cielo siga siendo tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vols protégés clouent au sol les applis que vous choisissez pendant tout le trajet, pour que le ciel reste le vôtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschützte Flüge legen deine gewählten Apps für die ganze Reise still, damit der Himmel dir gehört."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённые полёты отключают выбранные приложения на всё путешествие, чтобы небо осталось вашим."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voos protegidos deixam os apps escolhidos em terra durante toda a viagem, para o céu continuar sendo seu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I voli protetti tengono a terra le app che scegli per tutto il viaggio, così il cielo resta tuo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zborurile protejate țin la sol aplicațiile alese pe toată durata călătoriei, ca cerul să rămână al tău."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschermde vluchten houden je gekozen apps aan de grond tijdens de hele reis, zodat de lucht van jou blijft."
          }
        }
      }
    },
    "Purchase couldn't be completed. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
