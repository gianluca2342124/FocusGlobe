    "Your local flights, coins, streak, Store items and purchases stay on this device.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的本地飞行、金币、连续记录、商店物品与购买保留在本设备。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लोकल फ़्लाइट, सिक्के, स्ट्रीक, स्टोर आइटम और खरीदारी इसी डिवाइस पर रहेंगी।"
          }
