        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一次飞行中专注整整一小时。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही फ़्लाइट में पूरा एक घंटा फ़ोकस करें।"
          }
        },
        "es": {
