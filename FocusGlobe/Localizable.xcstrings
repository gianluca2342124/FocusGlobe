{
  "sourceLanguage": "en",
  "strings": {
    "Welcome to FocusGlobe": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 FocusGlobe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe में आपका स्वागत है"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida a FocusGlobe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans FocusGlobe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei FocusGlobe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в FocusGlobe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Boas-vindas ao FocusGlobe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti diamo il benvenuto in FocusGlobe"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bine ai venit în FocusGlobe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom bij FocusGlobe"
          }
        }
      }
    },
    "A calmer way to focus, one flight at a time.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更平静的专注方式，一次一段飞行。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत तरीके से फ़ोकस करें — एक बार में एक फ़्लाइट।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una forma más serena de concentrarte, un vuelo a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une façon plus sereine de se concentrer, un vol à la fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhiger fokussieren – ein Flug nach dem anderen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный способ сосредоточиться — по одному полёту."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um jeito mais tranquilo de focar, um voo por vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modo più sereno di concentrarti, un volo alla volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mod mai calm de a te concentra, un zbor pe rând."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rustiger focussen, één vlucht tegelijk."
          }
        }
      }
    },
