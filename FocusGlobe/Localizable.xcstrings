    "Ends this flight now. Its progress and rewards are not kept.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即结束本次飞行。其进度与奖励不会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़्लाइट अभी समाप्त होगी। इसकी प्रगति और इनाम सुरक्षित नहीं रहेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina este vuelo ahora. Su progreso y recompensas no se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met fin au vol maintenant. Sa progression et ses récompenses ne sont pas conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet diesen Flug sofort. Fortschritt und Belohnungen bleiben nicht erhalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает полёт сейчас. Прогресс и награды не сохраняются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra este voo agora. O progresso e as recompensas não são mantidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina subito questo volo. Progressi e ricompense non vengono conservati."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie acest zbor acum. Progresul și recompensele nu se păstrează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beëindigt deze vlucht nu. Voortgang en beloningen blijven niet bewaard."
