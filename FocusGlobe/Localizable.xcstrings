    },
    "Each link admits one new pilot, then expires — share a fresh one per friend. Copy Link lives inside the share sheet.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个链接仅允许一位新飞行员加入，之后失效 — 每位好友分享一个新链接。“拷贝链接”在分享面板中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर लिंक एक नए पायलट को प्रवेश देता है, फिर समाप्त हो जाता है — हर दोस्त के लिए नया लिंक भेजें। “लिंक कॉपी करें” शेयर शीट में है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada enlace admite a un piloto nuevo y luego caduca: comparte uno nuevo por cada amigo. Copiar enlace está dentro de la hoja para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lien admet un nouveau pilote puis expire — partagez-en un par ami. Copier le lien se trouve dans la feuille de partage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Link lässt einen neuen Piloten herein und läuft dann ab – teile pro Freund einen neuen. „Link kopieren“ steht im Teilen-Menü."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая ссылка впускает одного нового пилота и истекает — отправляйте новую каждому другу. «Скопировать ссылку» есть в меню share."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada link admite um piloto novo e depois expira — compartilhe um novo por amigo. Copiar link fica dentro da folha de compartilhamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni link ammette un nuovo pilota e poi scade: condividine uno nuovo per amico. Copia link è nel foglio di condivisione."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare link admite un pilot nou, apoi expiră — distribuie câte unul pentru fiecare prieten. Copiază linkul se află în fereastra de partajare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke link laat één nieuwe piloot toe en verloopt daarna — deel per vriend een nieuwe. Link kopiëren staat in het deelvenster."
          }
        }
      }
    },
