    "Touch and hold an empty area of your Home Screen until the apps jiggle.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主屏幕的空白处，直到 App 开始晃动。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम स्क्रीन की ख़ाली जगह को तब तक दबाए रखें जब तक ऐप हिलने न लगें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una zona vacía de la pantalla de inicio hasta que las apps se muevan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez une zone vide de l’écran d’accueil jusqu’à ce que les apps bougent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen leeren Bereich des Home-Bildschirms gedrückt, bis die Apps wackeln."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте пустое место на главном экране, пока приложения не задрожат."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure uma área vazia da Tela de Início até os apps tremerem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca e tieni premuta un’area vuota della schermata Home finché le app non tremano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge lung o zonă goală de pe ecranul principal până când aplicațiile tremură."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een leeg gebied van je beginscherm vast tot de apps wiebelen."
          }
        }
      }
    },
