    "Online Flights use a private FocusGlobe account with Sign in with Apple — you appear only as an anonymous alias." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online-Flüge nutzen ein privates FocusGlobe-Konto mit „Mit Apple anmelden“ — du erscheinst nur unter einem anonymen Alias."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vuelos Online usan una cuenta privada de FocusGlobe con Iniciar sesión con Apple: solo apareces con un alias anónimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vols en ligne utilisent un compte FocusGlobe privé via Se connecter avec Apple — vous n’apparaissez que sous un alias anonyme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑनलाइन फ़्लाइट «Sign in with Apple» वाले निजी FocusGlobe अकाउंट का इस्तेमाल करती हैं — आप सिर्फ़ एक गुमनाम उपनाम के रूप में दिखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I voli online usano un account FocusGlobe privato con Accedi con Apple: appari solo con uno pseudonimo anonimo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onlinevluchten gebruiken een privé FocusGlobe-account met Log in met Apple — je verschijnt alleen onder een anoniem alias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os voos Online usam uma conta privada do FocusGlobe com Iniciar Sessão com a Apple — você aparece apenas com um apelido anônimo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zborurile online folosesc un cont FocusGlobe privat cu Conectare cu Apple — apari doar sub un alias anonim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Онлайн-полёты используют приватный аккаунт FocusGlobe через «Вход с Apple» — вы отображаетесь только под анонимным псевдонимом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在线飞行使用通过「通过 Apple 登录」创建的私密 FocusGlobe 账户——你只会以匿名代号出现。"
          }
        }
      }
    },
