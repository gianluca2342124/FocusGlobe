        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्लाइट के दौरान ऐप ब्लॉक करने के लिए सेटिंग में FocusGlobe के लिए स्क्रीन टाइम एक्सेस चालू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear apps durante los vuelos, activa el acceso a Tiempo de uso para FocusGlobe en Ajustes."
          }
        },
        "fr": {
