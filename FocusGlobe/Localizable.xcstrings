          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले छह महीनों के असली फ़ोकस दिन एक जीवंत ग्रिड में — पासपोर्ट खोलने के लिए टैप करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
