    "Journeys, focused time, current + longest streak, your longest session — plus a few unlocked badges.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅程、专注时长、当前与最长连续记录、最长一次专注——外加几枚已解锁徽章。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यात्राएँ, फ़ोकस समय, मौजूदा + सबसे लंबी स्ट्रीक, सबसे लंबा सत्र — और कुछ अनलॉक बैज।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viajes, tiempo concentrado, racha actual y máxima, tu sesión más larga… y algunas insignias desbloqueadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyages, temps de concentration, série actuelle et record, votre plus longue session — et quelques badges débloqués."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reisen, Fokuszeit, aktuelle und längste Serie, deine längste Sitzung — plus einige freigeschaltete Abzeichen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путешествия, время фокуса, текущая и рекордная серии, самая долгая сессия — и несколько открытых значков."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Viagens, tempo de foco, sequência atual e recorde, sua sessão mais longa — e algumas medalhas desbloqueadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viaggi, tempo di concentrazione, serie attuale e record, la tua sessione più lunga — e alcuni badge sbloccati."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Călătorii, timp de concentrare, seria curentă și cea mai lungă, cea mai lungă sesiune — plus câteva insigne deblocate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reizen, focustijd, huidige en langste reeks, je langste sessie — plus een paar ontgrendelde badges."
          }
        }
      }
    },
