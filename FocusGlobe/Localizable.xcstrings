        }
      }
    },
    "Focus Shield is the part I didn't know I needed. Once a flight starts, my phone finally stops feeling like the thing I'm fighting against." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fokus-Schild ist der Teil, von dem ich nicht wusste, dass ich ihn brauche. Sobald ein Flug startet, fühlt sich mein Handy endlich nicht mehr wie mein Gegner an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Escudo de Enfoque es la parte que no sabía que necesitaba. En cuanto empieza un vuelo, el móvil deja de parecer aquello contra lo que peleo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Bouclier de Concentration, c’est ce dont j’ignorais avoir besoin. Dès qu’un vol commence, mon téléphone cesse enfin d’être ce que je combats."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोकस शील्ड वह हिस्सा है जिसकी ज़रूरत मुझे पता ही नहीं थी। फ़्लाइट शुरू होते ही मेरा फ़ोन आख़िरकार दुश्मन जैसा लगना बंद कर देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo Scudo Focus è la parte che non sapevo mi servisse. Appena parte un volo, il telefono smette finalmente di sembrare ciò contro cui combatto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Focusschild is het deel waarvan ik niet wist dat ik het nodig had. Zodra een vlucht start, voelt mijn telefoon eindelijk niet meer als iets waartegen ik vecht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Escudo de Foco é a parte que eu não sabia que precisava. Assim que um voo começa, meu celular finalmente para de parecer aquilo contra o que eu luto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scutul de Concentrare e partea de care nu știam că am nevoie. Odată ce începe un zbor, telefonul încetează în sfârșit să pară dușmanul meu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щит Фокуса — то, о необходимости чего я не догадывался. Как только начинается полёт, телефон перестаёт быть тем, с чем я борюсь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注护盾是我原本不知道自己需要的部分。飞行一开始，手机终于不再像是我要对抗的东西。"
          }
        }
      }
    },
    "Focus Shield needs Screen Time permission to block distracting apps during your FocusGlobe flights." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fokus-Schild braucht die Bildschirmzeit-Berechtigung, um ablenkende Apps während deiner FocusGlobe-Flüge zu blockieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Escudo de Enfoque necesita permiso de Tiempo de uso para bloquear apps que distraen durante tus vuelos de FocusGlobe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Bouclier de Concentration a besoin de l'autorisation Temps d'écran pour bloquer les applis distrayantes pendant vos vols FocusGlobe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FocusGlobe फ़्लाइट के दौरान ध्यान भटकाने वाले ऐप्स ब्लॉक करने के लिए फ़ोकस शील्ड को स्क्रीन टाइम अनुमति चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo Scudo Focus richiede l'autorizzazione Tempo di utilizzo per bloccare le app che distraggono durante i voli FocusGlobe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Focusschild heeft Schermtijd-toestemming nodig om afleidende apps te blokkeren tijdens je FocusGlobe-vluchten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Escudo de Foco precisa da permissão de Tempo de Uso para bloquear apps que distraem durante seus voos no FocusGlobe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scutul de Concentrare are nevoie de permisiunea Timp de utilizare ca să blocheze aplicațiile care distrag în timpul zborurilor FocusGlobe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щиту Фокуса нужно разрешение «Экранное время», чтобы блокировать отвлекающие приложения во время полётов FocusGlobe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注护盾需要“屏幕使用时间”权限，才能在 FocusGlobe 飞行期间屏蔽干扰应用。"
          }
        }
      }
    },
    "Focus Shield uses Screen Time, which isn't available on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fokus-Schild nutzt Bildschirmzeit, die auf diesem Gerät nicht verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Escudo de Enfoque usa Tiempo de uso, que no está disponible en este dispositivo."
          }
