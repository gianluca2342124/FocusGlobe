    "A calm Japanese evening — lantern glow and quiet temple roofs below." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ruhiger japanischer Abend — Laternenlicht und stille Tempeldächer unter dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un atardecer japonés en calma: el brillo de los faroles y los tejados de los templos abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un soir japonais paisible — la lueur des lanternes et les toits des temples en contrebas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक शांत जापानी शाम — लालटेन की चमक और नीचे शांत मंदिरों की छतें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sera giapponese calma: il bagliore delle lanterne e i tetti dei templi in basso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rustige Japanse avond — lantaarnlicht en stille tempeldaken beneden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um entardecer japonês calmo — o brilho das lanternas e os telhados dos templos abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seară japoneză liniștită — lumina lampioanelor și acoperișurile templelor dedesubt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спокойный японский вечер — свет фонарей и тихие крыши храмов внизу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个平静的日本夜晚——灯笼的暖光与下方安静的庙宇屋顶。"
          }
        }
      }
    },
