    "High snowy peaks in a cold, clean sunrise glow.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高耸的雪峰，沐浴在清冷洁净的日出光辉中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठंडी, साफ़ सूर्योदय की आभा में ऊँची बर्फ़ीली चोटियाँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altas cumbres nevadas bajo un amanecer frío y limpio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De hauts sommets enneigés dans une aube froide et limpide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Schneegipfel im kalten, klaren Licht des Sonnenaufgangs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокие снежные вершины в холодном чистом свете рассвета."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altos picos nevados sob um nascer do sol frio e limpo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte vette innevate in un’alba fredda e limpida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Piscuri înalte înzăpezite într-un răsărit rece și curat."
