          }
        }
      }
    },
    "This flight’s progress and rewards will be lost, and you’ll leave the Sky you’re flying in.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次飞行的进度与奖励将会丢失，你也会离开当前所在的天空。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़्लाइट की प्रगति और इनाम चले जाएँगे, और आप जिस आकाश में हैं उसे छोड़ देंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderás el progreso y las recompensas de este vuelo, y abandonarás el cielo en el que vuelas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression et les récompenses de ce vol seront perdues, et vous quitterez le ciel où vous volez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt und Belohnungen dieses Flugs gehen verloren, und du verlässt den Himmel, in dem du fliegst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс и награды этого полёта будут потеряны, и вы покинете небо, в котором летите."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso e as recompensas deste voo serão perdidos, e você sairá do céu em que está voando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progressi e le ricompense di questo volo andranno persi, e lascerai il cielo in cui stai volando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresul și recompensele acestui zbor se vor pierde, iar tu vei părăsi cerul în care zbori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voortgang en beloningen van deze vlucht gaan verloren, en je verlaat de lucht waarin je vliegt."
          }
        }
      }
    },
    "This flight’s progress and rewards will be lost.": {
