    "To block apps during flights, enable Screen Time access for FocusGlobe in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在飞行期间屏蔽应用，请在“设置”中为 FocusGlobe 启用“屏幕使用时间”访问权限。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्लाइट के दौरान ऐप ब्लॉक करने के लिए सेटिंग में FocusGlobe के लिए स्क्रीन टाइम एक्सेस चालू करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear apps durante los vuelos, activa el acceso a Tiempo de uso para FocusGlobe en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour bloquer les applis pendant les vols, activez l’accès Temps d’écran pour FocusGlobe dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Apps während Flügen zu blockieren, aktiviere den Bildschirmzeit-Zugriff für FocusGlobe in den Einstellungen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы блокировать приложения во время полётов, включите доступ к «Экранному времени» для FocusGlobe в Настройках."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear apps durante os voos, ative o acesso ao Tempo de Uso para o FocusGlobe nos Ajustes."
          }
        },
        "it": {
          "stringUnit": {
