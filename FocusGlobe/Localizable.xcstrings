    "Every gold square is a day you truly focused. Keep the sky lit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个金色方块都是你真正专注的一天。让天空持续点亮。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सुनहरा वर्ग वह दिन है जब आपने सचमुच फ़ोकस किया। आकाश को जगमगाता रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cuadro dorado es un día en el que te concentraste de verdad. Mantén el cielo encendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque carré doré est un jour où vous vous êtes vraiment concentré. Gardez le ciel allumé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes goldene Feld ist ein Tag mit echtem Fokus. Halte den Himmel erleuchtet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый золотой квадрат — день настоящего фокуса. Пусть небо горит."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada quadrado dourado é um dia em que você realmente focou. Mantenha o céu aceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni quadrato dorato è un giorno di vera concentrazione. Tieni il cielo acceso."
