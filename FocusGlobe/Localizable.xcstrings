    "Join my FocusGlobe flight — we focus together, side by side.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入我的 FocusGlobe 飞行——我们并肩一起专注。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरी FocusGlobe फ़्लाइट में शामिल हों — हम साथ-साथ फ़ोकस करते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a mi vuelo de FocusGlobe: nos concentramos juntos, lado a lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez mon vol FocusGlobe — on se concentre ensemble, côte à côte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm zu meinem FocusGlobe-Flug — wir fokussieren zusammen, Seite an Seite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединяйтесь к моему полёту FocusGlobe — фокусируемся вместе, бок о бок."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no meu voo do FocusGlobe — a gente foca junto, lado a lado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti al mio volo FocusGlobe: ci concentriamo insieme, fianco a fianco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Intră în zborul meu FocusGlobe — ne concentrăm împreună, unul lângă altul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe mee met mijn FocusGlobe-vlucht — we focussen samen, zij aan zij."
          }
        }
      }
