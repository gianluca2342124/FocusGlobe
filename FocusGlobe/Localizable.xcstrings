    "Soft rain over a muted neon skyline — cozy, blue, and quiet.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "细雨落在柔和的霓虹天际线上——温暖、湛蓝、安静。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मद्धम नियॉन स्काईलाइन पर हल्की बारिश — आरामदेह, नीली और शांत।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lluvia suave sobre un horizonte de neón apagado: acogedor, azul y tranquilo."
          }
        },
        "fr": {
