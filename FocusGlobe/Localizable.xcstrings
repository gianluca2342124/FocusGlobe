          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus últimos seis meses de dias reais de foco numa grade viva — toque para abrir o Passaporte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
