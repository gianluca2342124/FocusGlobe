        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时可以稍后重新发送请求。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बाद में नए अनुरोध से फिर जुड़ सकते हैं।"
