                  "value": "Focus %1$lld minute to unlock %2$@ — free, just keep flying."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Focus %1$lld minutes to unlock %2$@ — free, just keep flying."
