    "Reports are anonymous and reviewed by our team. Only this pilot's anonymous ID and your chosen reason are sent — never any personal details.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报为匿名并由我们团队审核。仅发送该飞行员的匿名 ID 与你选择的原因 — 绝不发送任何个人信息。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट गुमनाम होती हैं और हमारी टीम उनकी समीक्षा करती है। केवल इस पायलट की गुमनाम ID और आपका चुना कारण भेजा जाता है — कोई निजी जानकारी नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las denuncias son anónimas y las revisa nuestro equipo. Solo se envía el ID anónimo de este piloto y el motivo que elijas, nunca datos personales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements sont anonymes et examinés par notre équipe. Seuls l'identifiant anonyme du pilote et le motif choisi sont envoyés — jamais de données personnelles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen sind anonym und werden von unserem Team geprüft. Gesendet werden nur die anonyme ID dieses Piloten und dein gewählter Grund – niemals persönliche Daten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалобы анонимны и рассматриваются нашей командой. Отправляются только анонимный ID пилота и выбранная вами причина — никаких личных данных."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As denúncias são anônimas e revisadas pela nossa equipe. Só enviamos o ID anônimo deste piloto e o motivo escolhido — nunca dados pessoais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni sono anonime e riviste dal nostro team. Vengono inviati solo l'ID anonimo di questo pilota e il motivo scelto, mai dati personali."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportările sunt anonime și revizuite de echipa noastră. Se trimit doar ID-ul anonim al pilotului și motivul ales — niciodată date personale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn anoniem en worden door ons team bekeken. Alleen de anonieme ID van deze piloot en je gekozen reden worden verstuurd — nooit persoonlijke gegevens."
          }
        }
      }
    },
