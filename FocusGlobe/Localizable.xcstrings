    "A vast, silent desert night under a star-heavy sky.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "繁星密布的天幕下，一片辽阔而寂静的沙漠之夜。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारों से भरे आकाश के नीचे विशाल, ख़ामोश रेगिस्तानी रात।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una noche de desierto inmensa y silenciosa bajo un cielo cargado de estrellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nuit de désert vaste et silencieuse sous un ciel chargé d’étoiles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine weite, stille Wüstennacht unter einem sternenschweren Himmel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Огромная безмолвная ночь в пустыне под густо усыпанным звёздами небом."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma noite de deserto vasta e silenciosa sob um céu carregado de estrelas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notte del deserto vasta e silenziosa sotto un cielo carico di stelle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O noapte de deșert vastă și tăcută sub un cer plin de stele."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een weidse, stille woestijnnacht onder een sterrenrijke hemel."
