    "This can't be undone. Your local flights, coins and streak are kept.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。你的本地飞行、金币与连续记录会保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पूर्ववत नहीं किया जा सकता। आपकी लोकल फ़्लाइट, सिक्के और स्ट्रीक बनी रहेंगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Tus vuelos, monedas y racha locales se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Vos vols, pièces et série locaux sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen. Deine lokalen Flüge, Münzen und deine Serie bleiben erhalten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить. Ваши локальные полёты, монеты и серия сохраняются."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não pode ser desfeito. Seus voos, moedas e sequência locais são mantidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è reversibile. I tuoi voli, monete e serie locali vengono mantenuti."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acțiunea nu poate fi anulată. Zborurile, monedele și seria locale se păstrează."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. Je lokale vluchten, munten en reeks blijven behouden."
          }
        }
      }
    },
