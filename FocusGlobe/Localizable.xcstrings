    "I've tried a lot of focus timers. This is the first one that feels like a place I actually want to come back to every day.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我试过很多专注计时器。这是第一个让我真心愿意每天回来的地方。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने कई फ़ोकस टाइमर आज़माए हैं। यह पहला है जो ऐसी जगह लगता है जहाँ मैं सच में रोज़ लौटना चाहता हूँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He probado muchos temporizadores de concentración. Este es el primero que se siente como un sitio al que de verdad quiero volver cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai essayé beaucoup de minuteurs de concentration. C’est le premier qui donne envie de revenir chaque jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe viele Fokus-Timer ausprobiert. Das hier ist der erste, der sich wie ein Ort anfühlt, an den ich täglich zurück will."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я перепробовал много таймеров фокуса. Этот — первый, куда действительно хочется возвращаться каждый день."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já testei muitos timers de foco. Este é o primeiro que parece um lugar ao qual eu realmente quero voltar todo dia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho provato tanti timer per la concentrazione. Questo è il primo che sembra un posto in cui voglio davvero tornare ogni giorno."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am încercat multe cronometre de concentrare. Acesta e primul care pare un loc în care chiar vreau să revin zilnic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb veel focustimers geprobeerd. Dit is de eerste die voelt als een plek waar ik echt elke dag naar terug wil."
          }
        }
      }
    },
