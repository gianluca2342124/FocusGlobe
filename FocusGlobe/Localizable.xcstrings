    "Focus Shield needs Screen Time permission to block distracting apps during your FocusGlobe flights.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注护盾需要“屏幕使用时间”权限，才能在 FocusGlobe 飞行期间屏蔽干扰应用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe फ़्लाइट के दौरान ध्यान भटकाने वाले ऐप्स ब्लॉक करने के लिए फ़ोकस शील्ड को स्क्रीन टाइम अनुमति चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Escudo de Enfoque necesita permiso de Tiempo de uso para bloquear apps que distraen durante tus vuelos de FocusGlobe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bouclier de Concentration a besoin de l'autorisation Temps d'écran pour bloquer les applis distrayantes pendant vos vols FocusGlobe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fokus-Schild braucht die Bildschirmzeit-Berechtigung, um ablenkende Apps während deiner FocusGlobe-Flüge zu blockieren."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щиту Фокуса нужно разрешение «Экранное время», чтобы блокировать отвлекающие приложения во время полётов FocusGlobe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Escudo de Foco precisa da permissão de Tempo de Uso para bloquear apps que distraem durante seus voos no FocusGlobe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo Scudo Focus richiede l'autorizzazione Tempo di utilizzo per bloccare le app che distraggono durante i voli FocusGlobe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scutul de Concentrare are nevoie de permisiunea Timp de utilizare ca să blocheze aplicațiile care distrag în timpul zborurilor FocusGlobe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Focusschild heeft Schermtijd-toestemming nodig om afleidende apps te blokkeren tijdens je FocusGlobe-vluchten."
          }
        }
      }
    },
