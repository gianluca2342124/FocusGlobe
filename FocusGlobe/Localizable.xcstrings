    "Invite a friend and your next flight can feel less lonely.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请一位好友，下次飞行就不再孤单。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी दोस्त को बुलाएँ और अगली फ़्लाइट कम अकेली लगेगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a un amigo y tu próximo vuelo se sentirá menos solitario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez un ami et votre prochain vol sera moins solitaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade eine Freundin oder einen Freund ein – dein nächster Flug wird weniger einsam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пригласите друга — следующий полёт будет не таким одиноким."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide um amigo e seu próximo voo será menos solitário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita un amico e il prossimo volo sarà meno solitario."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Invită un prieten și următorul zbor va fi mai puțin singuratic."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig een vriend uit en je volgende vlucht voelt minder eenzaam."
          }
        }
      }
    },
    "Fly with a friend to earn 2× Focus Coins.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与好友同飞可获得 2 倍专注金币。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्त के साथ उड़ें और 2× फ़ोकस सिक्के कमाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuela con un amigo y gana monedas de concentración ×2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volez avec un ami pour gagner ×2 pièces de concentration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fliege mit einer Freundin oder einem Freund für 2× Fokus-Münzen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Летите с другом и получите 2× монеты фокуса."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voe com um amigo e ganhe moedas de foco 2×."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vola con un amico per guadagnare monete di concentrazione 2×."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zboară cu un prieten ca să câștigi monede de concentrare 2×."
          }
