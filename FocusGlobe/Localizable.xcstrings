    "You won't see each other in public Skies, and they can't send you requests or join your rooms.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你们不会在公共天空中互相看到，对方也无法向你发送请求或加入你的房间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप एक-दूसरे को सार्वजनिक आकाश में नहीं देखेंगे, और वे आपको अनुरोध नहीं भेज सकेंगे या आपके रूम में शामिल नहीं हो सकेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No os veréis en los cielos públicos y no podrá enviarte solicitudes ni unirse a tus salas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne vous verrez plus dans les ciels publics, et il ne pourra plus vous envoyer de demandes ni rejoindre vos salons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seht euch nicht mehr in öffentlichen Himmeln, und Anfragen oder Raumbeitritte sind nicht mehr möglich."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не увидите друг друга в публичных небесах, и он не сможет отправлять запросы или входить в ваши комнаты."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocês não se verão nos céus públicos, e essa pessoa não poderá enviar pedidos nem entrar nas suas salas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vi vedrete nei cieli pubblici e non potrà inviarti richieste né unirsi alle tue stanze."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu vă veți vedea în cerurile publice, iar el nu îți poate trimite cereri sau intra în camerele tale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jullie zien elkaar niet in publieke luchten, en verzoeken of deelname aan je rooms zijn niet meer mogelijk."
          }
        }
      }
    },
