    "Focus feels better in the sky. Your phone becomes a focus balloon flight." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus fühlt sich am Himmel besser an. Dein Handy wird zu einem Ballonflug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrarse sienta mejor en el cielo. Tu móvil se convierte en un vuelo en globo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La concentration est plus douce dans le ciel. Votre téléphone devient un vol en montgolfière."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आकाश में फ़ोकस बेहतर लगता है। आपका फ़ोन एक फ़ोकस बलून फ़्लाइट बन जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrarsi è più bello in cielo. Il tuo telefono diventa un volo in mongolfiera."
