    "Start a flight in a tap when idle, or watch the live time remaining on the flight you're on.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时一点即起飞，飞行中实时查看剩余时间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली हों तो एक टैप में फ़्लाइट शुरू करें, या चल रही फ़्लाइट का बचा समय देखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza un vuelo con un toque cuando no estés volando, o mira el tiempo restante del vuelo actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez un vol d’un geste au repos, ou suivez le temps restant du vol en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte im Ruhezustand einen Flug mit einem Tipp oder verfolge die Restzeit deines laufenden Flugs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните полёт одним касанием или следите за оставшимся временем текущего полёта."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece um voo com um toque quando estiver parado, ou veja o tempo restante do voo atual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia un volo con un tocco quando sei fermo, o guarda il tempo rimanente del volo in corso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe un zbor cu o atingere când ești liber, sau vezi timpul rămas din zborul curent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start met één tik een vlucht, of bekijk de resterende tijd van je huidige vlucht."
          }
        }
      }
    },
