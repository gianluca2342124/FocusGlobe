    "Last 6 months · each square is a day with 5+ focused minutes.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 6 个月 · 每个方块代表专注 5 分钟以上的一天。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 6 महीने · हर वर्ग वह दिन है जिसमें 5+ मिनट फ़ोकस हुआ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimos 6 meses · cada cuadro es un día con más de 5 minutos de concentración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "6 derniers mois · chaque carré est un jour avec plus de 5 minutes de concentration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte 6 Monate · jedes Feld ist ein Tag mit 5+ Fokus-Minuten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние 6 месяцев · каждый квадрат — день с 5+ минутами фокуса."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
