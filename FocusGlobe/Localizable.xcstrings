    "The Skies, sounds and Passport make progress feel visible without turning productivity into pressure. It's calm, simple and genuinely motivating.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天空、声音和护照让进步变得可见，却没有把效率变成压力。它平静、简单，也真的能激励人。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आकाश, ध्वनियाँ और पासपोर्ट प्रगति को दिखने लायक बना देते हैं, बिना उत्पादकता को दबाव में बदले। यह शांत, सरल और सच में प्रेरक है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cielos, los sonidos y el Pasaporte hacen visible el progreso sin convertir la productividad en presión. Es tranquilo, sencillo y realmente motivador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ciels, les sons et le Passeport rendent les progrès visibles sans transformer la productivité en pression. C’est calme, simple et vraiment motivant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Himmel, die Klänge und der Reisepass machen Fortschritt sichtbar, ohne Produktivität in Druck zu verwandeln. Ruhig, einfach und wirklich motivierend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небеса, звуки и Паспорт делают прогресс видимым, не превращая продуктивность в давление. Спокойно, просто и по-настоящему мотивирует."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os céus, os sons e o Passaporte tornam o progresso visível sem transformar produtividade em pressão. É calmo, simples e genuinamente motivador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cieli, i suoni e il Passaporto rendono i progressi visibili senza trasformare la produttività in pressione. È calmo, semplice e davvero motivante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerurile, sunetele și Pașaportul fac progresul vizibil fără să transforme productivitatea în presiune. E calm, simplu și chiar motivant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De luchten, geluiden en het Paspoort maken vooruitgang zichtbaar zonder productiviteit in druk te veranderen. Rustig, simpel en echt motiverend."
          }
        }
      }
    },
