    "What do you want FocusGlobe to help with most?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最希望 FocusGlobe 帮你做什么？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "FocusGlobe से आप सबसे ज़्यादा किसमें मदद चाहते हैं?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué quieres que FocusGlobe te ayude más?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur quoi voulez-vous que FocusGlobe vous aide le plus ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wobei soll FocusGlobe dir am meisten helfen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С чем FocusGlobe должен помочь больше всего?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com o que você mais quer a ajuda do FocusGlobe?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In cosa vuoi che FocusGlobe ti aiuti di più?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu ce vrei să te ajute FocusGlobe cel mai mult?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarbij wil je dat FocusGlobe je het meest helpt?"
          }
        }
      }
    },
    "We'll shape your first flight around it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会据此为你安排第一次飞行。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपकी पहली फ़्लाइट इसी के अनुसार तैयार करेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustaremos tu primer vuelo a eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous adapterons votre premier vol en conséquence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir richten deinen ersten Flug danach aus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы построим ваш первый полёт вокруг этого."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos moldar seu primeiro voo em torno disso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelleremo il tuo primo volo su questo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți vom construi primul zbor în jurul acestui lucru."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We stemmen je eerste vlucht daarop af."
          }
        }
      }
    },
    "What usually breaks your focus?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常是什么打断了你的专注？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोकस आमतौर पर किससे टूटता है?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué suele romper tu concentración?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui casse le plus souvent votre concentration ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was unterbricht deinen Fokus meistens?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что обычно сбивает вашу концентрацию?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que costuma quebrar seu foco?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa interrompe di solito la tua concentrazione?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce îți întrerupe de obicei concentrarea?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat verstoort meestal je focus?"
          }
        }
      }
    },
    "So FocusGlobe can meet you where you are.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 FocusGlobe 从你的实际情况出发。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि FocusGlobe आपकी स्थिति के अनुसार साथ दे सके।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que FocusGlobe te acompañe desde donde estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que FocusGlobe parte de là où vous en êtes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit FocusGlobe dich dort abholt, wo du stehst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы FocusGlobe отталкивался от вашей ситуации."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o FocusGlobe começar de onde você está."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così FocusGlobe parte da dove sei."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca FocusGlobe să pornească de unde ești."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat FocusGlobe aansluit bij waar jij staat."
          }
        }
      }
    },
    "How long can you focus today?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天你能专注多久？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आप कितनी देर फ़ोकस कर सकते हैं?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto puedes concentrarte hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps pouvez-vous vous concentrer aujourd'hui ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange kannst du dich heute konzentrieren?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько вы можете сосредоточиться сегодня?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quanto tempo você consegue focar hoje?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto riesci a concentrarti oggi?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât te poți concentra azi?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoelang kun je je vandaag focussen?"
          }
        }
      }
    },
    "Turn the dial. You can change it before every take-off.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转动表盘。每次起飞前都可以更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डायल घुमाएँ। हर टेक-ऑफ़ से पहले बदल सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira el dial. Puedes cambiarlo antes de cada despegue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez la molette. Vous pouvez la modifier avant chaque décollage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh am Regler. Du kannst ihn vor jedem Start ändern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверните диск. Вы можете изменить его перед каждым взлётом."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire o dial. Você pode mudar antes de cada decolagem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota la manopola. Puoi cambiarla prima di ogni decollo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotește discul. Îl poți schimba înainte de fiecare decolare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai aan de knop. Je kunt dit voor elke start aanpassen."
          }
        }
      }
    },
    "Which days do you want to focus?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想在哪几天专注？"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किन दिनों फ़ोकस करना चाहते हैं?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué días quieres concentrarte?"
