    "Your focus history stays on this device. No account, no tracking.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的专注历史保留在本设备。无需账号，无追踪。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोकस इतिहास इसी डिवाइस पर रहता है। कोई खाता नहीं, कोई ट्रैकिंग नहीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial de concentración se queda en este dispositivo. Sin cuenta, sin seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre historique de concentration reste sur cet appareil. Sans compte, sans suivi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fokus-Verlauf bleibt auf diesem Gerät. Kein Konto, kein Tracking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша история фокуса остаётся на этом устройстве. Без аккаунта и отслеживания."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu histórico de foco fica neste dispositivo. Sem conta, sem rastreamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cronologia di concentrazione resta su questo dispositivo. Nessun account, nessun tracciamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul tău de concentrare rămâne pe acest dispozitiv. Fără cont, fără urmărire."
