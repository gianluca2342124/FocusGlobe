    },
    "Your goal can’t. Keep flying.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "但你的目标不能。继续飞行。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लक्ष्य नहीं। उड़ते रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu objetivo no. Sigue volando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas votre objectif. Continuez à voler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ziel nicht. Flieg weiter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "А ваша цель — нет. Продолжайте полёт."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu objetivo não. Continue voando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo obiettivo no. Continua a volare."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obiectivul tău, nu. Continuă zborul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je doel niet. Blijf vliegen."
          }
        }
      }
    },
    "Don’t trade your goal": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别拿目标去交换"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना लक्ष्य दाँव पर मत लगाइए"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambies tu objetivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’échangez pas votre objectif"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausch dein Ziel nicht ein"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не меняйте свою цель"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não troque seu objetivo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non barattare il tuo obiettivo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu-ți da obiectivul la schimb"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruil je doel niet in"
          }
        }
      }
    },
    "A distraction is a poor exchange rate.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分心是一笔很差的交易。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ध्यान भटकाना बहुत महँगा सौदा है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una distracción es un mal cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une distraction, c’est un mauvais taux de change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ablenkung ist ein schlechter Tausch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвлечение — невыгодный обмен."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma distração é uma troca ruim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una distrazione è un pessimo affare."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O distragere e un schimb prost."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een afleiding is een slechte ruil."
          }
        }
      }
    },
    "Protect who you’re becoming": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守护正在成为的自己"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो बन रहे हैं, उसकी रक्षा करें"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege a quien estás llegando a ser"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez la personne que vous devenez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schütze dein künftiges Ich"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берегите того, кем становитесь"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja quem você está se tornando"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi la persona che stai diventando"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Protejează persoana care devii"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherm wie je aan het worden bent"
          }
        }
      }
    },
    "This is the part that builds them.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正是这一刻在塑造你。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यही वह हिस्सा है जो आपको बनाता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la parte que te construye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ce moment qui vous construit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau das baut dich auf."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Именно это вас и создаёт."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É esta parte que constrói você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È questa la parte che ti costruisce."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta e partea care te clădește."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is het deel dat jou opbouwt."
          }
        }
      }
    },
    "The urge will pass": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这股冲动会过去"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इच्छा गुज़र जाएगी"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ganas pasarán"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envie va passer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drang geht vorbei"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это желание пройдёт"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vontade vai passar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’impulso passerà"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Impulsul va trece"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De drang gaat voorbij"
          }
        }
      }
    },
    "It always does. Stay in the air.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它总会过去。留在空中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमेशा गुज़रती है। हवा में बने रहें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre pasa. Sigue en el aire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle passe toujours. Restez en l’air."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das tut er immer. Bleib in der Luft."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно всегда проходит. Оставайтесь в небе."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre passa. Fique no ar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa sempre. Resta in volo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întotdeauna trece. Rămâi în aer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat gaat altijd voorbij. Blijf in de lucht."
          }
        }
      }
    },
    "Your future deserves this": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的未来值得这一刻"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका भविष्य इसका हक़दार है"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu futuro se merece esto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre avenir mérite ce moment"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zukunft hat das verdient"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше будущее этого заслуживает"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu futuro merece isso"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo futuro se lo merita"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Viitorul tău merită asta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je toekomst verdient dit"
          }
        }
      }
    },
    "So does the hour you already committed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经投入的这一小时也是。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और वह घंटा भी जो आप पहले ही लगा चुके हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y también la hora que ya has invertido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et l’heure que vous y avez déjà consacrée aussi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und die Stunde, die du schon investiert hast, auch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И тот час, что вы уже вложили, — тоже."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E a hora que você já dedicou também."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E anche l’ora che hai già investito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fel și ora pe care ai investit-o deja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "En het uur dat je er al in stak ook."
          }
        }
      }
    },
    "Five focused minutes": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五分钟的专注"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच मिनट का फ़ोकस"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco minutos de concentración"
          }
        },
        "fr": {
