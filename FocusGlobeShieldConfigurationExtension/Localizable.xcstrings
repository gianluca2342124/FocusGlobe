          }
        }
      }
    },
    "That’s all it takes to change your day.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就足以改变你的一天。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दिन बदलने के लिए बस इतना ही काफ़ी है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es todo lo que hace falta para cambiar tu día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assez pour changer votre journée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr braucht es nicht, um deinen Tag zu ändern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого достаточно, чтобы изменить день."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta isso para mudar seu dia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È tutto ciò che serve per cambiare la giornata."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atât e nevoie ca să-ți schimbi ziua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer heb je niet nodig om je dag te veranderen."
          }
        }
      }
    },
    "Stay on course": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持航向"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी राह पर बने रहें"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el rumbo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le cap"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleib auf Kurs"
          }
        },
